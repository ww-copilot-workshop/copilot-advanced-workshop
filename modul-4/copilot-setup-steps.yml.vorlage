# =============================================================================
# VORLAGE — .github/workflows/copilot-setup-steps.yml
#
# Diese Datei definiert die Umgebung, in der der Copilot Coding Agent arbeitet.
# Sie läuft VOR dem Agenten. Was danach fehlt, fehlt für den ganzen Lauf.
#
# Zielort:  .github/workflows/copilot-setup-steps.yml
# Prüfen:   Als normalen Actions-Workflow über workflow_dispatch starten.
#           Wenn er dort grün ist, funktioniert er auch für den Agenten.
# =============================================================================

name: "Copilot Setup Steps"

on:
  workflow_dispatch:
  push:
    paths:
      - .github/workflows/copilot-setup-steps.yml
  pull_request:
    paths:
      - .github/workflows/copilot-setup-steps.yml

jobs:
  # -------------------------------------------------------------------------
  # Der Job MUSS exakt so heißen. Ein anderer Name wird still ignoriert —
  # der Agent läuft dann ohne eure Umgebung und ihr sucht eine Stunde.
  # -------------------------------------------------------------------------
  copilot-setup-steps:

    # TODO(1): Runner wählen.
    #   Heute:  ubuntu-latest   (GitHub-hosted, keine eigene Infrastruktur nötig)
    #   Größer: ubuntu-4-core   (Larger Runner, falls der Build lange braucht)
    #
    #   Unterstützt sind Ubuntu x64 und Windows 64-bit.
    runs-on: ubuntu-latest

    # TODO(2): Laufzeitbegrenzung. Maximum ist 59 — das entspricht dem harten
    #   Session-Limit des Agenten. Höhere Werte werden nicht akzeptiert.
    timeout-minutes: 25

    permissions:
      contents: read

    # =======================================================================
    # ACHTUNG — nur SECHS Job-Keys werden überhaupt ausgewertet:
    #
    #     steps, permissions, runs-on, services, snapshot, timeout-minutes
    #
    # Alles andere wird STILL ignoriert. Kein Fehler, keine Warnung, nichts.
    # Insbesondere ein `env:` auf JOB-Ebene tut nichts. Environment-Variablen
    # gehören auf Step-Ebene. Das ist der Klassiker, an dem alle einmal
    # eine halbe Stunde verlieren.
    # =======================================================================

    steps:
      - name: Checkout
        uses: actions/checkout@v6
        # Hinweis: fetch-depth wird vom Agenten ohnehin überschrieben.
        # Spart euch die Diskussion darüber.

      - name: Java einrichten
        uses: actions/setup-java@v5
        with:
          java-version: "21"
          distribution: temurin
          cache: maven
          cache-dependency-path: |
            **/pom.xml

      # ---------------------------------------------------------------------
      # TODO(3): Abhängigkeiten vorab holen.
      #
      # Warum das wichtig ist: Nach den Setup-Steps ist der Netzzugang des
      # Agenten durch die eingebaute Copilot-Firewall beschränkt. Was jetzt
      # nicht im lokalen Repository liegt, fehlt später — und der Agent
      # scheitert an einer Stelle, die mit seiner eigentlichen Aufgabe
      # nichts zu tun hat.
      #
      # Der passende Maven-Aufruf holt alle Abhängigkeiten, ohne zu bauen.
      # ---------------------------------------------------------------------
      - name: Abhängigkeiten vorab auflösen
        run: mvn -B -ntp -DskipTests TODO

      # ---------------------------------------------------------------------
      # TODO(4) — optional, aber empfohlen:
      # Ein Schritt, der beweist, dass die Umgebung funktioniert. Zum Beispiel
      # ein Testlauf. Denkt daran: Schlagen die Setup-Steps fehl, BRICHT DER
      # AGENT NICHT AB — er arbeitet ohne die Umgebung weiter und produziert
      # einen PR, der auf eurem Rechner nicht baut.
      #
      # Deshalb: ins Setup-Log schauen, nicht nur auf den Diff.
      # ---------------------------------------------------------------------

# =============================================================================
# ANHANG A — Secrets für den Agenten
#
# Secrets liegen unter Settings > Secrets and variables > AGENTS.
# Das ist ein EIGENER Secret-Typ. Actions-Secrets sind für den Agenten
# unsichtbar — auch dann, wenn sie exakt so heißen.
#
# Sie stehen in den Setup-Steps als normale Environment-Variablen zur
# Verfügung, aber nur auf STEP-Ebene (siehe die Warnung oben).
#
# Der Präfix COPILOT_MCP_ hat Sonderverhalten: Secrets mit diesem Präfix
# werden an konfigurierte MCP-Server durchgereicht.
# =============================================================================

# =============================================================================
# ANHANG B — Wenn ihr später einen internen Repository-Proxy anbindet
#
# Heute nicht nötig: ubuntu-latest zieht direkt von Maven Central.
# Sobald ihr im eigenen Haus arbeitet, kommt dieser Schritt dazu.
# Er steht hier, damit ihr ihn nicht neu erfinden müsst.
#
#      - name: Maven settings.xml für internen Proxy schreiben
#        run: |
#          mkdir -p "$HOME/.m2"
#          cat > "$HOME/.m2/settings.xml" <<'EOF'
#          <?xml version="1.0" encoding="UTF-8"?>
#          <settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
#            <mirrors>
#              <mirror>
#                <id>intern</id>
#                <url>${env.REPO_PROXY_URL}</url>
#                <mirrorOf>*</mirrorOf>
#              </mirror>
#            </mirrors>
#            <servers>
#              <server>
#                <!-- id MUSS mit der id des Mirrors uebereinstimmen,
#                     sonst greifen die Zugangsdaten nicht. Haeufigster Fehler. -->
#                <id>intern</id>
#                <username>${env.REPO_PROXY_USER}</username>
#                <password>${env.REPO_PROXY_TOKEN}</password>
#              </server>
#            </servers>
#          </settings>
#          EOF
#
# Zwei Details, die hier wirklich zählen:
#
#   1. Das Heredoc ist mit <<'EOF' gequotet (einfache Anführungszeichen).
#      Dadurch schreibt die Shell ${env.X} WÖRTLICH in die Datei, und Maven
#      löst es erst zur Laufzeit auf. Ohne die Quotes ersetzt die Shell die
#      Variablen sofort — und schreibt eure Zugangsdaten im Klartext in die
#      Datei und, bei aktivem `set -x`, ins Log.
#
#   2. actions/setup-java hat KEINEN Input für Maven-Mirrors. Diese Datei
#      müsst ihr selbst schreiben. Es gibt keinen kürzeren Weg.
# =============================================================================

# =============================================================================
# ANHANG C — Wenn ihr später auf eigene Runner wechselt
#
# Der Coding Agent unterstützt self-hosted Runner (GA). Was sich dann ändert:
#
#   [ ] runs-on zeigt auf euren Runner-Pool statt auf ubuntu-latest.
#   [ ] Jeder Lauf muss ephemer sein. Persistente Runner sind nicht zulässig.
#   [ ] Die eingebaute Copilot-Firewall wird für self-hosted Runner
#       deaktiviert. Eure eigene Egress-Allowlist übernimmt ihre Rolle —
#       eine bewusste Übergabe von Verantwortung. Klärt vorher, WER sie hat.
#   [ ] Der Agent braucht Netzzugang zu den GitHub- und Copilot-Endpunkten
#       plus zu eurem Repository-Proxy. Proxy-Einstellungen laufen über
#       Environment-Variablen auf Step-Ebene.
#   [ ] Org-Level Runner-Controls können Repo-Overrides sperren. Klärt, ob
#       euer Repo überhaupt ein eigenes runs-on setzen darf.
#   [ ] Copilot Code Review teilt sich standardmäßig die Umgebung mit dem
#       Coding Agent. Wollt ihr das trennen?
#
# Merksatz für diesen Schritt: Ihr tauscht eine fertige, abgesicherte
# Umgebung gegen eine eigene ein. Der Gewinn ist Kontrolle, der Preis ist
# Verantwortung. Beides gehört in dieselbe Entscheidungsvorlage.
# =============================================================================
