# =============================================================================
# VORLAGE — .github/workflows/copilot-setup-steps.yml
#
# Diese Datei definiert die Umgebung, in der der Copilot Coding Agent arbeitet.
# Sie läuft VOR dem Agenten. Danach ist das Netz zu, und was nicht da ist, fehlt.
#
# Zielort:  .github/workflows/copilot-setup-steps.yml
# Prüfen:   Als normalen Actions-Workflow über workflow_dispatch starten.
#           Wenn er dort grün ist, funktioniert er auch für den Agenten.
# =============================================================================

name: "Copilot Setup Steps"

on:
  workflow_dispatch:
  push:
    paths:
      - .github/workflows/copilot-setup-steps.yml
  pull_request:
    paths:
      - .github/workflows/copilot-setup-steps.yml

jobs:
  # -------------------------------------------------------------------------
  # Der Job MUSS exakt so heißen. Ein anderer Name wird still ignoriert —
  # der Agent läuft dann ohne eure Umgebung und ihr sucht eine Stunde.
  # -------------------------------------------------------------------------
  copilot-setup-steps:

    # TODO(1): Runner wählen.
    #   GitHub-hosted:            ubuntu-latest
    #   Euer ARC Scale Set:       der Name des Scale Sets, z.B. arc-java-ephemeral
    #
    #   Unterstützt sind Ubuntu x64 und Windows 64-bit. Persistente Runner sind
    #   nicht zulässig — jeder Lauf ist ephemer. Das ist keine Empfehlung.
    runs-on: ubuntu-latest

    # TODO(2): Laufzeitbegrenzung. Maximum ist 59 — das entspricht dem harten
    #   Session-Limit des Agenten. Höhere Werte werden nicht akzeptiert.
    timeout-minutes: 25

    permissions:
      contents: read

    # =======================================================================
    # ACHTUNG — nur SECHS Job-Keys werden überhaupt ausgewertet:
    #
    #     steps, permissions, runs-on, services, snapshot, timeout-minutes
    #
    # Alles andere wird STILL ignoriert. Kein Fehler, keine Warnung, nichts.
    # Insbesondere ein `env:` auf JOB-Ebene tut nichts. Environment-Variablen
    # gehören auf Step-Ebene. Das ist der Klassiker, an dem alle einmal
    # eine halbe Stunde verlieren.
    # =======================================================================

    steps:
      - name: Checkout
        uses: actions/checkout@v6
        # Hinweis: fetch-depth wird vom Agenten ohnehin überschrieben.
        # Spart euch die Diskussion darüber.

      - name: Java einrichten
        uses: actions/setup-java@v5
        with:
          java-version: "21"
          distribution: temurin
          cache: maven
          cache-dependency-path: |
            **/pom.xml

      # ---------------------------------------------------------------------
      # TODO(3): Artifactory-Proxy einrichten.
      #
      # actions/setup-java hat KEINEN Input für Maven-Mirrors. Die settings.xml
      # müsst ihr selbst schreiben. Vervollständigt den Block unten.
      #
      # Zwei Dinge, die hier wichtig sind:
      #
      #   1. Das Heredoc ist mit <<'EOF' gequotet (einfache Anführungszeichen).
      #      Dadurch schreibt die Shell ${env.X} WÖRTLICH in die Datei, und Maven
      #      löst es später zur Laufzeit auf. Ohne die Quotes ersetzt die Shell
      #      die Variablen sofort — und schreibt eure Zugangsdaten im Klartext
      #      ins Log, falls jemand `set -x` aktiviert hat.
      #
      #   2. ARTIFACTORY_URL, ARTIFACTORY_USER und ARTIFACTORY_TOKEN kommen aus
      #      Settings > Secrets and variables > AGENTS.
      #      NICHT aus Actions-Secrets — die sind für den Agenten unsichtbar.
      #      Das ist ein eigener Secret-Typ. Der Präfix COPILOT_MCP_ hat noch
      #      einmal ein eigenes Sonderverhalten.
      # ---------------------------------------------------------------------
      - name: Maven settings.xml für Artifactory schreiben
        run: |
          mkdir -p "$HOME/.m2"
          cat > "$HOME/.m2/settings.xml" <<'EOF'
          <?xml version="1.0" encoding="UTF-8"?>
          <settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
            <mirrors>
              <mirror>
                <id>artifactory</id>
                <name>Artifactory Remote Repository Proxy</name>
                <url>${env.ARTIFACTORY_URL}</url>
                <!-- TODO(3a): Welche Repositories soll dieser Mirror ersetzen?
                     Für einen Proxy, der alles abdeckt, gibt es genau einen Wert. -->
                <mirrorOf>TODO</mirrorOf>
              </mirror>
            </mirrors>
            <servers>
              <server>
                <!-- TODO(3b): Die id MUSS mit der id des Mirrors übereinstimmen,
                     sonst greifen die Zugangsdaten nicht. Häufiger Fehler. -->
                <id>TODO</id>
                <username>${env.ARTIFACTORY_USER}</username>
                <password>${env.ARTIFACTORY_TOKEN}</password>
              </server>
            </servers>
          </settings>
          EOF

      # ---------------------------------------------------------------------
      # TODO(4): Abhängigkeiten vorab holen.
      #
      # Warum das wichtig ist: Nach den Setup-Steps ist der Netzzugang des
      # Agenten auf eure Egress-Allowlist beschränkt. Was jetzt nicht im
      # lokalen Repository liegt, fehlt später — und der Agent scheitert
      # an einer Stelle, die mit seiner eigentlichen Aufgabe nichts zu tun hat.
      #
      # Der passende Maven-Aufruf holt alle Abhängigkeiten, ohne zu bauen.
      # ---------------------------------------------------------------------
      - name: Abhängigkeiten vorab auflösen
        run: mvn -B -ntp -DskipTests TODO

      # ---------------------------------------------------------------------
      # TODO(5) — optional, aber empfohlen:
      # Ein Schritt, der beweist, dass die Umgebung funktioniert. Zum Beispiel
      # ein Testlauf. Denkt daran: Schlagen die Setup-Steps fehl, BRICHT DER
      # AGENT NICHT AB — er arbeitet ohne die Umgebung weiter und produziert
      # einen PR, der auf eurem Rechner nicht baut.
      #
      # Deshalb: ins Setup-Log schauen, nicht nur auf den Diff.
      # ---------------------------------------------------------------------

# =============================================================================
# NOCH ZU KLÄREN, bevor das produktiv geht — schreibt es in euren PR:
#
#   [ ] Die eingebaute Copilot-Firewall MUSS für self-hosted Runner deaktiviert
#       werden. Eure Egress-Allowlist übernimmt deren Rolle. Wer besitzt diese
#       Allowlist, und wer darf sie ändern?
#
#   [ ] Welche Hosts braucht der Agent über euren Proxy zusätzlich zu
#       Artifactory? (GitHub-API, Copilot-Inference-Endpunkte, Actions-Cache.)
#
#   [ ] Proxy-Konfiguration für den Agenten läuft über Environment-Variablen.
#       Auf STEP-Ebene, nicht auf Job-Ebene. Siehe oben.
#
#   [ ] Org-Level Runner-Controls können Repo-Overrides sperren. Klärt, ob euer
#       Repo überhaupt ein eigenes runs-on setzen darf.
#
#   [ ] Copilot Code Review teilt sich standardmäßig die Umgebung mit dem
#       Coding Agent. Wollt ihr das trennen?
# =============================================================================
